[Unit]
Description=ScrapeNet Waitlist Web
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/scrapenet/apps/waitlist
Environment=PORT=8080
Environment=DATA_DIR=/var/lib/scrapenet-waitlist
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=1

# Hardening (light)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/scrapenet-waitlist

[Install]
WantedBy=multi-user.target
